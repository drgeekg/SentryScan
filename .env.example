# ==============================================================================
# SentryScan LLM & Environment Configuration
# ==============================================================================
# Default / Global Provider:
#   deterministic | ollama | openai | gemini | anthropic | openrouter | nvidia | custom
SENTRYSCAN_LLM_PROVIDER=deterministic

# Optional Global Overrides (if set, overrides provider-specific values below)
# SENTRYSCAN_LLM_MODEL=
# SENTRYSCAN_LLM_BASE_URL=
# SENTRYSCAN_LLM_API_KEY=

# ==============================================================================
# Purpose-Specific Provider Routing (Optional Overrides)
# ==============================================================================
# Route different LLM providers, models, or API keys to specific subsystems.
# If left blank or commented out, each subsystem falls back to SENTRYSCAN_LLM_PROVIDER.

# 1. Executive Posture Report Generation (Runs every 30m or on-demand)
# SENTRYSCAN_REPORT_LLM_PROVIDER=openai
# SENTRYSCAN_REPORT_LLM_MODEL=gpt-4o
# SENTRYSCAN_REPORT_LLM_BASE_URL=https://api.openai.com/v1
# SENTRYSCAN_REPORT_LLM_API_KEY=

# 2. Interactive SOC Copilot Q&A (Live console assistance)
# SENTRYSCAN_COPILOT_LLM_PROVIDER=ollama
# SENTRYSCAN_COPILOT_LLM_MODEL=llama3.2
# SENTRYSCAN_COPILOT_LLM_BASE_URL=http://127.0.0.1:11434
# SENTRYSCAN_COPILOT_LLM_API_KEY=ollama

# 3. Agent Task Bidding & Negotiation (VIGIL / SENTRA Contract-Net)
# SENTRYSCAN_AGENT_LLM_PROVIDER=deterministic
# SENTRYSCAN_AGENT_LLM_MODEL=
# SENTRYSCAN_AGENT_LLM_BASE_URL=
# SENTRYSCAN_AGENT_LLM_API_KEY=

# ------------------------------------------------------------------------------
# 1. Ollama (Local Self-Hosted)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=ollama

# ------------------------------------------------------------------------------
# 2. OpenAI
# ------------------------------------------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Google Gemini
# ------------------------------------------------------------------------------
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Anthropic Claude
# ------------------------------------------------------------------------------
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 5. OpenRouter
# ------------------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 6. NVIDIA NIM (Cloud or Self-Hosted)
# ------------------------------------------------------------------------------
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_API_KEY=

# ------------------------------------------------------------------------------
# 7. Custom / Local OpenAI-Compatible (vLLM, LMStudio, LiteLLM, FastChat)
# ------------------------------------------------------------------------------
CUSTOM_BASE_URL=http://127.0.0.1:8000/v1
CUSTOM_MODEL=default
CUSTOM_API_KEY=not-needed

# ------------------------------------------------------------------------------
# Security & Knowledge Base Overrides
# ------------------------------------------------------------------------------
# Optional NVD API Key for live CVE feed querying (reads offline cache by default)
NVD_API_KEY=
