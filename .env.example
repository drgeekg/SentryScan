# SentryScan Environment Configuration Template
# Copy this file to .env and populate keys as needed. Real keys are NEVER committed.

# LLM Provider Configuration (deterministic | ollama | openrouter | nvidia | gemini | anthropic | openai | fake)
SENTRYSCAN_LLM_PROVIDER=deterministic

# Local Ollama Endpoint (default loopback)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Provider API Keys (Used only for live demo runs; tests never require keys)
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional NVD API Key for rate-limit bypass (reads from cache by default)
NVD_API_KEY=
